{
  "$schema": "http://json.schemastore.org/template",
  "author": "Dreambit Engine",
  "classifications": [
    "Game",
    "Dreambit",
    "MonoGame"
  ],
  "identity": "DreambitEngine.Templates.Game",
  "groupIdentity": "DreambitEngine.Templates.Game",
  "name": "Dreambit Engine Game",
  "shortName": "dreambit-game",
  "sourceName": "DreambitGame",
  "defaultName": "DreambitGame",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "gameTitle": {
      "type": "parameter",
      "datatype": "text",
      "displayName": "Game title",
      "description": "The human-readable title displayed in the game window.",
      "defaultValue": "Dreambit Game",
      "replaces": "Dreambit Game"
    },
    "sdkVersion": {
      "type": "parameter",
      "datatype": "text",
      "displayName": "Dreambit SDK version",
      "description": "Coordinated Dreambit NuGet package version used by the generated game.",
      "defaultValue": "0.9.4",
      "replaces": "__DREAMBIT_SDK_VERSION__"
    },
    "targetRenderer": {
      "type": "parameter",
      "datatype": "choice",
      "displayName": "Target renderer",
      "description": "Primary renderer/platform for the generated launcher.",
      "defaultValue": "DesktopVK",
      "replaces": "__DREAMBIT_TARGET_RENDERER__",
      "choices": [
        {
          "choice": "DesktopVK",
          "description": "Desktop Vulkan launcher for Windows, macOS, and Linux."
        }
      ]
    },
    "targetFps": {
      "type": "parameter",
      "datatype": "int",
      "displayName": "Target FPS",
      "description": "Initial target frame rate used by Program.cs.",
      "defaultValue": "240",
      "replaces": "__DREAMBIT_TARGET_FPS__"
    }
  },
  "guids": [
    "4C5011FD-105B-42FB-B48D-0F2B3A42A001",
    "4C5011FD-105B-42FB-B48D-0F2B3A42A002",
    "4C5011FD-105B-42FB-B48D-0F2B3A42A003",
    "4C5011FD-105B-42FB-B48D-0F2B3A42A004"
  ],
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        ".template.config/**/*",
        ".git/**/*",
        ".idea/**/*",
        ".vs/**/*",
        ".vscode/**/*",
        "**/[Bb]in/**/*",
        "**/[Oo]bj/**/*",
        "**/[Aa]rtifacts/**/*",
        "**/*.user",
        "**/*.DotSettings.user",
        "src/**/[Bb]uild/**/*"
      ]
    }
  ],
  "primaryOutputs": [
    {
      "path": "DreambitGame.sln"
    },
    {
      "path": "src/DreambitGame.VK/DreambitGame.VK.csproj"
    }
  ]
}
