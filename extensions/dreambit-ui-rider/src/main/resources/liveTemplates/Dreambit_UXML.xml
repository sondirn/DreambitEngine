<templateSet group="Dreambit UXML">
  <template name="dbui" value="&lt;Ui&gt;&#10;    $END$&#10;&lt;/Ui&gt;" description="Dreambit UI layout root" toReformat="true" toShortenFQNames="true">
    <context><option name="XML" value="true" /></context>
  </template>
  <template name="dbcomponent" value="&lt;UiComponent&gt;&#10;    $END$&#10;&lt;/UiComponent&gt;" description="Dreambit reusable UI component root" toReformat="true" toShortenFQNames="true">
    <context><option name="XML" value="true" /></context>
