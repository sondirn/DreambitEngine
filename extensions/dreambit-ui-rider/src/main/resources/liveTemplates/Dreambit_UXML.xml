  <template name="dbinclude" value="&lt;Include source=&quot;$PATH$&quot; /&gt;$END$" description="Dreambit UXML include" toReformat="true" toShortenFQNames="true">
    <variable name="PATH" expression="" defaultValue="&quot;Ui/components/component.uxml&quot;" alwaysStopAt="true" />
    <context><option name="XML" value="true" /></context>
  </template>
</templateSet>
