{
  "comments": {
    "blockComment": [
      "/*",
      "*/"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "/*",
      "close": "*/"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "wordPattern": "(-?((\\d*\\.\\d+)|(\\d+\\.?))(px|%|[a-zA-Z-]+)?)|([#.]?[-_a-zA-Z][-_a-zA-Z0-9]*)",
  "indentationRules": {
    "increaseIndentPattern": "^.*\\{[^}]*$",
    "decreaseIndentPattern": "^\\s*}"
  },
  "folding": {
    "markers": {
      "start": "^\\s*/\\*\\s*#region\\b.*\\*/",
      "end": "^\\s*/\\*\\s*#endregion\\b.*\\*/"
    }
  }
}
