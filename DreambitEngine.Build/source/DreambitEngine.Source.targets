<Project>
  <!-- Build integration for games that reference a DreambitEngine source submodule. -->
  <PropertyGroup>
    <DreambitContentBuildEnabled Condition="'$(DreambitContentBuildEnabled)' == ''">true</DreambitContentBuildEnabled>
    <DreambitContentRoot>$([System.IO.Path]::GetFullPath('$(DreambitContentRoot)'))</DreambitContentRoot>
    <DreambitContentProject>$([System.IO.Path]::GetFullPath('$(DreambitContentProject)'))</DreambitContentProject>
    <DreambitEngineContentProject>$([System.IO.Path]::GetFullPath('$(DreambitEngineRoot)/Dreambit.Content/Dreambit.Content.csproj'))</DreambitEngineContentProject>
    <DreambitEngineContentRoot>$([System.IO.Path]::GetFullPath('$(DreambitEngineRoot)/Dreambit.Content/Assets'))</DreambitEngineContentRoot>
    <DreambitAssetBakerProject>$([System.IO.Path]::GetFullPath('$(DreambitEngineRoot)/DreambitEngine.AssetBaker/DreambitEngine.AssetBaker.csproj'))</DreambitAssetBakerProject>
    <DreambitRuntimeOutput>$([System.IO.Path]::GetFullPath('$(BaseOutputPath)$(Configuration)'))</DreambitRuntimeOutput>
    <DreambitRuntimeContent>$(DreambitRuntimeOutput)/Content</DreambitRuntimeContent>
    <DreambitContentCacheRoot Condition="'$(DreambitContentCacheRoot)' == ''">$([System.IO.Path]::GetFullPath('$(DreambitProjectRoot)/.cache/dreambit'))</DreambitContentCacheRoot>
    <DreambitContentPak Condition="'$(DreambitContentPak)' == ''">$(DreambitContentCacheRoot)/content.pak</DreambitContentPak>
    <DreambitAssetCache Condition="'$(DreambitAssetCache)' == ''">$(DreambitContentCacheRoot)/bake</DreambitAssetCache>
    <DreambitBlobManifest>$(DreambitAssetCache)/content.blobs.json</DreambitBlobManifest>
    <DreambitBlobFingerprint>$(DreambitAssetCache)/content.blobs.fingerprint</DreambitBlobFingerprint>
    <DreambitPakFingerprint>$(DreambitContentPak).fingerprint</DreambitPakFingerprint>
    <DreambitBlobRuntimeOutputArgument Condition="'$(Configuration)' == 'Debug'"> --runtime-output &quot;$(DreambitRuntimeContent)&quot;</DreambitBlobRuntimeOutputArgument>
    <DreambitAssetRegistry Condition="'$(DreambitAssetRegistry)' == ''">$([System.IO.Path]::GetFullPath('$(DreambitProjectRoot)/.dreambit/assets.json'))</DreambitAssetRegistry>
    <DreambitContentBuildStamp>$([System.IO.Path]::GetFullPath('$(BaseIntermediateOutputPath)DreambitContent/build.stamp'))</DreambitContentBuildStamp>
    <DreambitUserContentIntermediate>$([System.IO.Path]::GetFullPath('$(BaseIntermediateOutputPath)DreambitUserContent'))</DreambitUserContentIntermediate>
    <DreambitEngineContentIntermediate>$([System.IO.Path]::GetFullPath('$(BaseIntermediateOutputPath)DreambitEngineContent'))</DreambitEngineContentIntermediate>
  </PropertyGroup>

  <ItemGroup>
    <_DreambitSourceContentInput Include="$(MSBuildThisFileFullPath);$(DreambitContentProject);$(DreambitEngineContentProject);$(DreambitAssetBakerProject)" />
    <_DreambitSourceContentInput Include="$(DreambitAssetRegistry)" Condition="Exists('$(DreambitAssetRegistry)')" />
    <_DreambitSourceContentInput Include="$(DreambitContentRoot)/**/*;$(DreambitEngineContentRoot)/**/*" />
    <_DreambitSourceContentInput Include="$([System.IO.Path]::GetDirectoryName('$(DreambitContentProject)'))/Builder/**/*.cs" />
    <_DreambitSourceContentInput Include="$([System.IO.Path]::GetDirectoryName('$(DreambitEngineContentProject)'))/Builder/**/*.cs" />
    <UpToDateCheckInput Include="@(_DreambitSourceContentInput)" />
    <!-- The blob fingerprint is the authoritative editor-save handoff. Watching it prevents
         IDE fast up-to-date checks from skipping the content copy after an editor bake. -->
    <UpToDateCheckInput Include="$(DreambitBlobFingerprint)"
                        Condition="Exists('$(DreambitBlobFingerprint)')" />
    <UpToDateCheckOutput Include="$(DreambitRuntimeContent)/content.blobs.fingerprint"
                         Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <Target Name="ValidateDreambitSourceContent"
          Condition="'$(DreambitContentBuildEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(MonoGamePlatform)' == ''" Text="MonoGamePlatform must be set by the executable project." />
    <Error Condition="'$(DreambitProjectRoot)' == ''" Text="DreambitProjectRoot must point to the game repository root." />
    <Error Condition="!Exists('$(DreambitContentProject)')" Text="The game content project was not found at '$(DreambitContentProject)'." />
    <Error Condition="!Exists('$(DreambitEngineContentProject)')" Text="DreambitEngine content tools were not found. Initialize the .dreambit/engine submodule." />
    <Error Condition="!Exists('$(DreambitAssetBakerProject)')" Text="DreambitEngine AssetBaker was not found. Initialize the .dreambit/engine submodule." />
  </Target>

  <Target Name="BuildDreambitSourceContent"
          BeforeTargets="BeforeCompile"
          DependsOnTargets="ValidateDreambitSourceContent"
          Condition="'$(DreambitContentBuildEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'"
          Inputs="@(_DreambitSourceContentInput)"
          Outputs="$(DreambitContentBuildStamp)">
    <Message Text="Building Dreambit source content for $(MonoGamePlatform)..." Importance="high" />
    <MSBuild Projects="$(DreambitEngineContentProject)"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;RuntimeIdentifiers;OutputPath;BaseOutputPath;ManagePackageVersionsCentrally;CentralPackageTransitivePinningEnabled" />
    <MSBuild Projects="$(DreambitContentProject)"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;RuntimeIdentifiers;OutputPath;BaseOutputPath;ManagePackageVersionsCentrally;CentralPackageTransitivePinningEnabled" />
    <MSBuild Projects="$(DreambitAssetBakerProject)"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;RuntimeIdentifiers;OutputPath;BaseOutputPath;ManagePackageVersionsCentrally;CentralPackageTransitivePinningEnabled" />
    <MakeDir Directories="$(DreambitRuntimeContent);$(DreambitContentCacheRoot);$(DreambitAssetCache);$([System.IO.Path]::GetDirectoryName('$(DreambitContentBuildStamp)'))" />
    <Exec Command="dotnet run --project &quot;$(DreambitEngineContentProject)&quot; --configuration &quot;$(Configuration)&quot; --no-build --no-restore -- build -p &quot;$(MonoGamePlatform)&quot; -s &quot;$(DreambitEngineContentRoot)&quot; -o &quot;$(DreambitRuntimeOutput)&quot; -i &quot;$(DreambitEngineContentIntermediate)&quot;" />
    <Exec Command="dotnet run --project &quot;$(DreambitContentProject)&quot; --configuration &quot;$(Configuration)&quot; --no-build --no-restore -- build -p &quot;$(MonoGamePlatform)&quot; -s &quot;$(DreambitContentRoot)&quot; -o &quot;$(DreambitRuntimeOutput)&quot; -i &quot;$(DreambitUserContentIntermediate)&quot;" />
    <Touch Files="$(DreambitContentBuildStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="BuildDreambitSourceBlobs"
          BeforeTargets="BeforeCompile"
          DependsOnTargets="BuildDreambitSourceContent"
          Condition="'$(DreambitContentBuildEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(DreambitContentCacheRoot);$(DreambitAssetCache)" />
    <Exec Command="dotnet run --project &quot;$(DreambitAssetBakerProject)&quot; --configuration &quot;$(Configuration)&quot; --no-build --no-restore -- bake-blobs &quot;$(DreambitContentRoot)&quot; &quot;$(DreambitAssetCache)&quot; --registry &quot;$(DreambitAssetRegistry)&quot; --platform &quot;$(MonoGamePlatform)&quot; --premul --srgb$(DreambitBlobRuntimeOutputArgument)"
          Condition="Exists('$(DreambitAssetRegistry)')" />
    <Exec Command="dotnet run --project &quot;$(DreambitAssetBakerProject)&quot; --configuration &quot;$(Configuration)&quot; --no-build --no-restore -- bake-blobs &quot;$(DreambitContentRoot)&quot; &quot;$(DreambitAssetCache)&quot; --platform &quot;$(MonoGamePlatform)&quot; --premul --srgb$(DreambitBlobRuntimeOutputArgument)"
          Condition="!Exists('$(DreambitAssetRegistry)')" />
  </Target>

  <Target Name="BakeDreambitPak"
          DependsOnTargets="BuildDreambitSourceBlobs"
          Condition="'$(DreambitContentBuildEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(DreambitAssetBakerProject)&quot; --configuration &quot;$(Configuration)&quot; --no-build --no-restore -- bake-pak &quot;$(DreambitContentRoot)&quot; &quot;$(DreambitContentPak)&quot; --registry &quot;$(DreambitAssetRegistry)&quot; --cache &quot;$(DreambitAssetCache)&quot; --platform &quot;$(MonoGamePlatform)&quot; --premul --srgb"
          Condition="Exists('$(DreambitAssetRegistry)')" />
    <Exec Command="dotnet run --project &quot;$(DreambitAssetBakerProject)&quot; --configuration &quot;$(Configuration)&quot; --no-build --no-restore -- bake-pak &quot;$(DreambitContentRoot)&quot; &quot;$(DreambitContentPak)&quot; --cache &quot;$(DreambitAssetCache)&quot; --platform &quot;$(MonoGamePlatform)&quot; --premul --srgb"
          Condition="!Exists('$(DreambitAssetRegistry)')" />
  </Target>

  <Target Name="ValidateDreambitSourcePak"
          BeforeTargets="BeforeCompile"
          DependsOnTargets="BuildDreambitSourceBlobs"
          Condition="'$(DreambitContentBuildEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(Configuration)' != 'Debug'">
    <Error Condition="!Exists('$(DreambitContentPak)') or !Exists('$(DreambitPakFingerprint)')"
           Text="The shipping content pak is missing. Open Dreambit Editor and choose Build > Bake Pak before building $(Configuration)." />
    <ReadLinesFromFile File="$(DreambitBlobFingerprint)">
      <Output TaskParameter="Lines" ItemName="_DreambitCurrentBlobFingerprint" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(DreambitPakFingerprint)">
      <Output TaskParameter="Lines" ItemName="_DreambitCurrentPakFingerprint" />
    </ReadLinesFromFile>
    <Error Condition="'@(_DreambitCurrentBlobFingerprint)' != '@(_DreambitCurrentPakFingerprint)'"
           Text="The shipping content pak is stale. Open Dreambit Editor and choose Build > Bake Pak before building $(Configuration)." />
  </Target>

  <Target Name="CopyDreambitSourceContentToOutput"
          AfterTargets="Build"
          DependsOnTargets="BuildDreambitSourceBlobs"
          Condition="'$(DreambitContentBuildEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(DreambitRuntimeContent)" />
    <!-- Debug blobs are published while the baker still owns the shared-cache writer lease.
         Keeping the copy inside that transaction prevents editor/build snapshot races. -->
    <Delete Files="$(DreambitRuntimeContent)/content.pak;$(DreambitRuntimeContent)/content.pak.fingerprint"
            Condition="'$(Configuration)' == 'Debug'" />
    <Copy SourceFiles="$(DreambitContentPak)"
          DestinationFiles="$(DreambitRuntimeContent)/.dreambit-content.pak.tmp"
          SkipUnchangedFiles="true"
          Condition="'$(Configuration)' != 'Debug'" />
    <Move SourceFiles="$(DreambitRuntimeContent)/.dreambit-content.pak.tmp"
          DestinationFiles="$(DreambitRuntimeContent)/content.pak"
          Condition="'$(Configuration)' != 'Debug' and Exists('$(DreambitRuntimeContent)/.dreambit-content.pak.tmp')" />
  </Target>

  <Target Name="IncludeDreambitSourceContentInPublish"
          AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="BuildDreambitSourceBlobs"
          Condition="'$(DreambitContentBuildEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup Condition="'$(Configuration)' != 'Debug'">
      <ResolvedFileToPublish Include="$(DreambitContentPak)" RelativePath="Content/content.pak" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
      <_DreambitPublishBlob Include="$(DreambitAssetCache)/blobs/**/*" />
      <ResolvedFileToPublish Include="$(DreambitBlobManifest)" RelativePath="Content/content.blobs.json" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(DreambitBlobFingerprint)" RelativePath="Content/content.blobs.fingerprint" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="@(_DreambitPublishBlob)" RelativePath="Content/blobs/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
