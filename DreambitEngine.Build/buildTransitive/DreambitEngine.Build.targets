<Project>
  <PropertyGroup>
    <DreambitAssetBakerDll Condition="'$(DreambitAssetBakerDll)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/net8.0/any/AssetBaker.dll'))</DreambitAssetBakerDll>
    <DreambitContentCacheRoot Condition="'$(DreambitContentCacheRoot)' == '' and '$(DreambitProjectRoot)' != ''">$([System.IO.Path]::GetFullPath('$(DreambitProjectRoot)/.cache/dreambit'))</DreambitContentCacheRoot>
    <DreambitContentCacheRoot Condition="'$(DreambitContentCacheRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/.cache/dreambit'))</DreambitContentCacheRoot>
    <DreambitContentPak Condition="'$(DreambitContentPak)' == ''">$(DreambitContentCacheRoot)/content.pak</DreambitContentPak>
    <DreambitAssetCache Condition="'$(DreambitAssetCache)' == ''">$(DreambitContentCacheRoot)/bake</DreambitAssetCache>
    <DreambitBlobManifest>$(DreambitAssetCache)/content.blobs.json</DreambitBlobManifest>
    <DreambitBlobFingerprint>$(DreambitAssetCache)/content.blobs.fingerprint</DreambitBlobFingerprint>
    <DreambitPakFingerprint>$(DreambitContentPak).fingerprint</DreambitPakFingerprint>
    <DreambitRuntimeContentDirectory Condition="'$(DreambitRuntimeContentDirectory)' == ''">$(TargetDir)Content</DreambitRuntimeContentDirectory>
    <DreambitBlobRuntimeOutputArgument Condition="'$(Configuration)' == 'Debug'"> --runtime-output &quot;$(DreambitRuntimeContentDirectory)&quot;</DreambitBlobRuntimeOutputArgument>
  </PropertyGroup>

  <ItemGroup>
    <ProjectCapability Include="Dreambit" />
    <_DreambitRawAsset Include="$(DreambitContentRoot)/**/*"
                       Condition="'$(DreambitContentBuildEnabled)' == 'true' and '$(DreambitContentRoot)' != ''" />
    <UpToDateCheckInput Include="@(_DreambitRawAsset)" />
    <UpToDateCheckInput Include="$(DreambitAssetRegistry)"
                        Condition="Exists('$(DreambitAssetRegistry)')" />
    <!-- The blob fingerprint is the authoritative editor-save handoff. Watching it prevents
         IDE fast up-to-date checks from skipping the content copy after an editor bake. -->
    <UpToDateCheckInput Include="$(DreambitBlobFingerprint)"
                        Condition="Exists('$(DreambitBlobFingerprint)')" />
    <UpToDateCheckOutput Include="$(DreambitRuntimeContentDirectory)/content.blobs.fingerprint"
                         Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <Target Name="ValidateDreambitAssetBuild"
          Condition="'$(DreambitContentBuildEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(DreambitContentRoot)' == '' or !Exists('$(DreambitContentRoot)')"
           Text="DreambitContentRoot must point to the project's raw Content/Assets directory." />
    <Error Condition="!Exists('$(DreambitAssetBakerDll)')"
           Text="Dreambit AssetBaker was not found at '$(DreambitAssetBakerDll)'. Restore DreambitEngine.Build again." />
    <Error Condition="'$(MonoGamePlatform)' == ''"
           Text="MonoGamePlatform must be set by the executable project." />
  </Target>

  <Target Name="BuildDreambitAssets"
          BeforeTargets="BeforeCompile"
          DependsOnTargets="ValidateDreambitAssetBuild"
          Condition="'$(DreambitContentBuildEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(DreambitContentCacheRoot);$(DreambitAssetCache)" />
    <Exec Command="dotnet &quot;$(DreambitAssetBakerDll)&quot; bake-blobs &quot;$(DreambitContentRoot)&quot; &quot;$(DreambitAssetCache)&quot; --registry &quot;$(DreambitAssetRegistry)&quot; --platform &quot;$(MonoGamePlatform)&quot; --premul --srgb$(DreambitBlobRuntimeOutputArgument)"
          Condition="Exists('$(DreambitAssetRegistry)')" />
    <Exec Command="dotnet &quot;$(DreambitAssetBakerDll)&quot; bake-blobs &quot;$(DreambitContentRoot)&quot; &quot;$(DreambitAssetCache)&quot; --platform &quot;$(MonoGamePlatform)&quot; --premul --srgb$(DreambitBlobRuntimeOutputArgument)"
          Condition="!Exists('$(DreambitAssetRegistry)')" />
  </Target>

  <Target Name="RebuildDreambitAssets"
          DependsOnTargets="ValidateDreambitAssetBuild"
          Condition="'$(DreambitContentBuildEnabled)' == 'true'">
    <MakeDir Directories="$(DreambitContentCacheRoot);$(DreambitAssetCache)" />
    <Exec Command="dotnet &quot;$(DreambitAssetBakerDll)&quot; bake-blobs &quot;$(DreambitContentRoot)&quot; &quot;$(DreambitAssetCache)&quot; --registry &quot;$(DreambitAssetRegistry)&quot; --platform &quot;$(MonoGamePlatform)&quot; --rebuild --premul --srgb$(DreambitBlobRuntimeOutputArgument)"
          Condition="Exists('$(DreambitAssetRegistry)')" />
    <Exec Command="dotnet &quot;$(DreambitAssetBakerDll)&quot; bake-blobs &quot;$(DreambitContentRoot)&quot; &quot;$(DreambitAssetCache)&quot; --platform &quot;$(MonoGamePlatform)&quot; --rebuild --premul --srgb$(DreambitBlobRuntimeOutputArgument)"
          Condition="!Exists('$(DreambitAssetRegistry)')" />
  </Target>

  <Target Name="BakeDreambitPak"
          DependsOnTargets="ValidateDreambitAssetBuild"
          Condition="'$(DreambitContentBuildEnabled)' == 'true'">
    <MakeDir Directories="$(DreambitContentCacheRoot);$(DreambitAssetCache)" />
    <Exec Command="dotnet &quot;$(DreambitAssetBakerDll)&quot; bake-pak &quot;$(DreambitContentRoot)&quot; &quot;$(DreambitContentPak)&quot; --registry &quot;$(DreambitAssetRegistry)&quot; --cache &quot;$(DreambitAssetCache)&quot; --platform &quot;$(MonoGamePlatform)&quot; --premul --srgb"
          Condition="Exists('$(DreambitAssetRegistry)')" />
    <Exec Command="dotnet &quot;$(DreambitAssetBakerDll)&quot; bake-pak &quot;$(DreambitContentRoot)&quot; &quot;$(DreambitContentPak)&quot; --cache &quot;$(DreambitAssetCache)&quot; --platform &quot;$(MonoGamePlatform)&quot; --premul --srgb"
          Condition="!Exists('$(DreambitAssetRegistry)')" />
  </Target>

  <Target Name="ValidateDreambitPak"
          BeforeTargets="BeforeCompile"
          DependsOnTargets="BuildDreambitAssets"
          Condition="'$(DreambitContentBuildEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(Configuration)' != 'Debug'">
    <Error Condition="!Exists('$(DreambitContentPak)') or !Exists('$(DreambitPakFingerprint)')"
           Text="The shipping content pak is missing. Open Dreambit Editor and choose Build > Bake Pak before building $(Configuration)." />
    <ReadLinesFromFile File="$(DreambitBlobFingerprint)">
      <Output TaskParameter="Lines" ItemName="_DreambitCurrentBlobFingerprint" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(DreambitPakFingerprint)">
      <Output TaskParameter="Lines" ItemName="_DreambitCurrentPakFingerprint" />
    </ReadLinesFromFile>
    <Error Condition="'@(_DreambitCurrentBlobFingerprint)' != '@(_DreambitCurrentPakFingerprint)'"
           Text="The shipping content pak is stale. Open Dreambit Editor and choose Build > Bake Pak before building $(Configuration)." />
  </Target>

  <Target Name="CopyDreambitAssetsToOutput"
          AfterTargets="Build"
          DependsOnTargets="BuildDreambitAssets"
          Condition="'$(DreambitContentBuildEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(DreambitRuntimeContentDirectory)" />
    <!-- Debug blobs are published while the baker still owns the shared-cache writer lease.
         Keeping the copy inside that transaction prevents editor/build snapshot races. -->
    <Delete Files="$(DreambitRuntimeContentDirectory)/content.pak;$(DreambitRuntimeContentDirectory)/content.pak.fingerprint"
            Condition="'$(Configuration)' == 'Debug'" />
    <Copy SourceFiles="$(DreambitContentPak)"
          DestinationFiles="$(DreambitRuntimeContentDirectory)/.dreambit-content.pak.tmp"
          SkipUnchangedFiles="true"
          Condition="'$(Configuration)' != 'Debug'" />
    <Move SourceFiles="$(DreambitRuntimeContentDirectory)/.dreambit-content.pak.tmp"
          DestinationFiles="$(DreambitRuntimeContentDirectory)/content.pak"
          Condition="'$(Configuration)' != 'Debug' and Exists('$(DreambitRuntimeContentDirectory)/.dreambit-content.pak.tmp')" />
  </Target>

  <Target Name="IncludeDreambitAssetsInPublish"
          AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="BuildDreambitAssets"
          Condition="'$(DreambitContentBuildEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup Condition="'$(Configuration)' != 'Debug'">
      <ResolvedFileToPublish Include="$(DreambitContentPak)"
                             RelativePath="Content/content.pak"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
      <_DreambitPublishBlob Include="$(DreambitAssetCache)/blobs/**/*" />
      <ResolvedFileToPublish Include="$(DreambitBlobManifest)"
                             RelativePath="Content/content.blobs.json"
                             CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(DreambitBlobFingerprint)"
                             RelativePath="Content/content.blobs.fingerprint"
                             CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="@(_DreambitPublishBlob)"
                             RelativePath="Content/blobs/%(RecursiveDir)%(Filename)%(Extension)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
