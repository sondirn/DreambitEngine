<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>

    <PackageId>DreambitEngine.Build</PackageId>
    <PackageVersion Condition="'$(PackageVersion)' == ''">0.9.4</PackageVersion>
    <Title>Dreambit Engine Build Integration</Title>
    <Authors>Dreambit Engine</Authors>
    <Description>MSBuild integration point for Dreambit content and asset tooling.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>dreambit;msbuild;content-pipeline</PackageTags>
    <RepositoryUrl>https://github.com/Twisted-Demon/DreambitEngine</RepositoryUrl>
    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);IncludeAssetBakerTools
    </TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Include="buildTransitive/**/*"
          Pack="true"
          PackagePath="buildTransitive" />
    <None Include="source/**/*"
          Pack="true"
          PackagePath="source" />
    <Compile Remove="**/*" />
  </ItemGroup>

  <Target Name="IncludeAssetBakerTools">
    <PropertyGroup>
      <_AssetBakerPublishDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/obj/assetbaker-publish'))/</_AssetBakerPublishDirectory>
    </PropertyGroup>
    <MSBuild Projects="../DreambitEngine.AssetBaker/DreambitEngine.AssetBaker.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(_AssetBakerPublishDirectory);UseAppHost=false;PublishReadyToRun=false;NoRestore=true;Restore=false;RestoreIgnoreFailedSources=true;NuGetAudit=false"
             RemoveProperties="TargetFramework;RuntimeIdentifier;RuntimeIdentifiers;OutputPath;BaseOutputPath" />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(_AssetBakerPublishDirectory)**/*">
        <PackagePath>tools/net8.0/any/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
